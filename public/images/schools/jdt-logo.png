<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="jdt-crimson" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#991b1b" />
      <stop offset="100%" stop-color="#7f1d1d" />
    </linearGradient>
    <linearGradient id="jdt-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a8a" />
      <stop offset="100%" stop-color="#1e40af" />
    </linearGradient>
    <filter id="jdt-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="#991b1b" stroke-width="4" filter="url(#jdt-shadow)" />
  <circle cx="100" cy="100" r="87" fill="none" stroke="#1e3a8a" stroke-width="1.5" stroke-dasharray="3,3" />

  <!-- Shield Shape -->
  <path d="M 60 55 L 140 55 C 140 55 142 98 100 136 C 58 98 60 55 60 55 Z" fill="url(#jdt-crimson)" stroke="#fbbf24" stroke-width="2.5" />

  <!-- Arch Dome Motif -->
  <path d="M 75 110 L 75 88 Q 100 68 125 88 L 125 110 Z" fill="url(#jdt-blue)" stroke="#fbbf24" stroke-width="1.5" />

  <!-- Open Book "IQRAA" -->
  <path d="M 80 88 Q 100 82 100 92 Q 100 82 120 88 L 118 102 Q 100 97 100 106 Q 100 97 82 102 Z" fill="#ffffff" />
  <text x="100" y="99" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="6.5" fill="#991b1b" letter-spacing="1">IQRAA</text>

  <!-- Radiant Star above Arch -->
  <polygon points="100,58 102,63 107,63 103,66 105,71 100,68 95,71 97,66 93,63 98,63" fill="#fbbf24" />

  <!-- Top Banner -->
  <text x="100" y="32" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="9" fill="#991b1b" letter-spacing="1.5">JDT IQRAA ENGLISH</text>
  <text x="100" y="44" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="7.5" fill="#1e3a8a" letter-spacing="1">CALICUT &#8226; ESTD 1985</text>

  <!-- Bottom Ribbon -->
  <path d="M 38 154 Q 100 168 162 154 L 158 170 Q 100 184 42 170 Z" fill="url(#jdt-blue)" stroke="#fbbf24" stroke-width="1.5"/>
  <text x="100" y="164" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="8" fill="#ffffff" letter-spacing="1.2">READ &#8226; RISE &#8226; EXCEL</text>
</svg>
