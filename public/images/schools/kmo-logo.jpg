<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="kmo-indigo" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4338ca" />
      <stop offset="100%" stop-color="#312e81" />
    </linearGradient>
    <linearGradient id="kmo-pink" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f43f5e" />
      <stop offset="100%" stop-color="#ec4899" />
    </linearGradient>
    <filter id="kmo-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="#4338ca" stroke-width="4" filter="url(#kmo-shadow)" />
  <circle cx="100" cy="100" r="87" fill="none" stroke="#ec4899" stroke-width="1.5" stroke-dasharray="4,2" />

  <!-- Central Shield -->
  <path d="M 60 52 L 140 52 C 140 52 144 95 100 135 C 56 95 60 52 60 52 Z" fill="url(#kmo-indigo)" stroke="url(#kmo-pink)" stroke-width="2.5"/>

  <!-- Soaring Dove of Peace / Graduation Mortarboard Symbol -->
  <!-- Mortarboard Cap -->
  <polygon points="100,66 126,76 100,86 74,76" fill="#ffffff" />
  <rect x="90" y="86" width="20" height="10" rx="3" fill="#ffffff" />
  <path d="M 126 76 L 132 94" stroke="#fbbf24" stroke-width="2" />
  <circle cx="132" cy="94" r="2.5" fill="#fbbf24" />

  <!-- Open Book Below Cap -->
  <path d="M 76 100 Q 100 94 100 102 Q 100 94 124 100 L 122 114 Q 100 108 100 118 Q 100 108 78 114 Z" fill="url(#kmo-pink)" />
  <path d="M 80 103 Q 100 97 100 105 Q 100 97 120 103 L 118 112 Q 100 107 100 115 Q 100 107 82 112 Z" fill="#ffffff" />

  <!-- Top Title -->
  <text x="100" y="30" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="9" fill="#312e81" letter-spacing="1.5">KMO ENGLISH SCHOOL</text>
  <text x="100" y="42" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="7.5" fill="#ec4899" letter-spacing="1">KODUVALLY &#8226; ESTD 1998</text>

  <!-- Bottom Ribbon -->
  <path d="M 38 154 Q 100 168 162 154 L 158 170 Q 100 184 42 170 Z" fill="url(#kmo-indigo)" stroke="url(#kmo-pink)" stroke-width="1.5"/>
  <text x="100" y="164" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="8" fill="#ffffff" letter-spacing="1.2">LIGHT &#8226; WISDOM &#8226; TRUTH</text>
</svg>
