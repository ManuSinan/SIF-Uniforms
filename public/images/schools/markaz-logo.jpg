<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="markaz-slate" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="markaz-green" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#10b981" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>
    <filter id="markaz-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="#1e293b" stroke-width="4" filter="url(#markaz-shadow)" />
  <circle cx="100" cy="100" r="87" fill="none" stroke="#10b981" stroke-width="2" />

  <!-- 8-Pointed Star Center Badge -->
  <g fill="url(#markaz-slate)" stroke="#10b981" stroke-width="2">
    <rect x="62" y="62" width="76" height="76" rx="12" />
    <rect x="62" y="62" width="76" height="76" rx="12" transform="rotate(45 100 100)" />
  </g>

  <!-- Emblem Center: Crescent & Open Book & Tree -->
  <circle cx="100" cy="100" r="32" fill="url(#markaz-green)" />
  
  <!-- White Open Book -->
  <path d="M 82 96 Q 100 90 100 99 Q 100 90 118 96 L 116 110 Q 100 104 100 114 Q 100 104 84 110 Z" fill="#ffffff" />
  
  <!-- Minaret / Quill Pinnacle -->
  <polygon points="100,75 104,88 96,88" fill="#ffffff" />
  <circle cx="100" cy="73" r="2.5" fill="#fde047" />

  <!-- Top Title -->
  <text x="100" y="30" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="8.5" fill="#1e293b" letter-spacing="1.5">MARKAZ RESIDENTIAL</text>
  <text x="100" y="42" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="7.5" fill="#059669" letter-spacing="1">KARANTHUR &#8226; ESTD 1992</text>

  <!-- Bottom Ribbon -->
  <path d="M 36 156 Q 100 170 164 156 L 160 172 Q 100 186 40 172 Z" fill="#1e293b" stroke="#10b981" stroke-width="1.5"/>
  <text x="100" y="166" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="7.5" fill="#ffffff" letter-spacing="1.2">CHARACTER &#8226; KNOWLEDGE</text>
</svg>
