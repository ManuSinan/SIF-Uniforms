<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="mes-teal" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f766e" />
      <stop offset="100%" stop-color="#134e4a" />
    </linearGradient>
    <linearGradient id="mes-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047" />
      <stop offset="50%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <filter id="mes-shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.2"/>
    </filter>
  </defs>

  <!-- Outer Ring -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="#0f766e" stroke-width="4" filter="url(#mes-shadow)" />
  <circle cx="100" cy="100" r="87" fill="none" stroke="url(#mes-gold)" stroke-width="2" />

  <!-- Octagon / Shield Accent -->
  <polygon points="100,50 135,62 145,100 135,138 100,150 65,138 55,100 65,62" fill="url(#mes-teal)" stroke="url(#mes-gold)" stroke-width="2.5" />

  <!-- Traditional Lamp of Wisdom / Diya -->
  <ellipse cx="100" cy="116" rx="20" ry="6" fill="url(#mes-gold)" />
  <path d="M 82 116 C 82 126 118 126 118 116 Z" fill="url(#mes-gold)" />
  <rect x="96" y="124" width="8" height="10" fill="url(#mes-gold)" />
  <ellipse cx="100" cy="134" rx="14" ry="3" fill="url(#mes-gold)" />

  <!-- Flame -->
  <path d="M 100 86 C 92 98 94 108 100 114 C 106 108 108 98 100 86 Z" fill="#ef4444" />
  <path d="M 100 93 C 96 100 97 106 100 110 C 103 106 104 100 100 93 Z" fill="url(#mes-gold)" />

  <!-- Open Book under Lamp -->
  <path d="M 75 70 Q 100 64 100 75 Q 100 64 125 70 L 122 79 Q 100 74 100 82 Q 100 74 78 79 Z" fill="#ffffff" opacity="0.95" />

  <!-- Top Title -->
  <text x="100" y="30" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="9" fill="#0f766e" letter-spacing="2">MES HIGH SCHOOL</text>
  <text x="100" y="42" text-anchor="middle" font-family="sans-serif" font-weight="700" font-size="7.5" fill="#d97706" letter-spacing="1">ESTABLISHED 1972</text>

  <!-- Bottom Sanskrit Motto Banner -->
  <path d="M 36 156 Q 100 170 164 156 L 160 172 Q 100 186 40 172 Z" fill="#0f766e" stroke="url(#mes-gold)" stroke-width="1.5"/>
  <text x="100" y="166" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="7.5" fill="#ffffff" letter-spacing="1">VIDYA DADATI VINAYAM</text>
</svg>
