<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="100%" height="100%">
  <defs>
    <linearGradient id="sxhs-blue" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a8a" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="sxhs-gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fde047" />
      <stop offset="50%" stop-color="#f59e0b" />
      <stop offset="100%" stop-color="#d97706" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-opacity="0.25"/>
    </filter>
  </defs>

  <!-- Outer Circle Border -->
  <circle cx="100" cy="100" r="94" fill="#ffffff" stroke="url(#sxhs-gold)" stroke-width="4" filter="url(#shadow)" />
  <circle cx="100" cy="100" r="88" fill="none" stroke="#1e3a8a" stroke-width="2" stroke-dasharray="3,2" />

  <!-- Shield Body -->
  <path d="M 60 52 L 140 52 C 140 52 144 95 100 135 C 56 95 60 52 60 52 Z" fill="url(#sxhs-blue)" stroke="url(#sxhs-gold)" stroke-width="3"/>
  
  <!-- Shield Cross Divider -->
  <path d="M 100 52 L 100 135" stroke="url(#sxhs-gold)" stroke-width="2.5" />
  <path d="M 62 82 L 138 82" stroke="url(#sxhs-gold)" stroke-width="2.5" />

  <!-- Symbols inside shield -->
  <!-- Top Left: Open Book -->
  <path d="M 72 65 Q 80 62 88 67 L 88 77 Q 80 73 72 76 Z" fill="#ffffff" />
  <path d="M 72 65 Q 64 62 56 67 L 56 77 Q 64 73 72 76 Z" fill="#ffffff" transform="translate(36, 0) scale(-1, 1)" />
  
  <!-- Top Right: Star of Excellence -->
  <polygon points="120,60 122,66 128,66 123,70 125,76 120,72 115,76 117,70 112,66 118,66" fill="url(#sxhs-gold)" />

  <!-- Bottom: Torch of Knowledge -->
  <polygon points="98,92 102,92 101,112 99,112" fill="url(#sxhs-gold)" />
  <ellipse cx="100" cy="90" rx="3.5" ry="6" fill="#ef4444" />
  <ellipse cx="100" cy="91" rx="2" ry="3.5" fill="#fde047" />

  <!-- Ribbon at Bottom -->
  <path d="M 40 152 Q 100 168 160 152 L 155 168 Q 100 182 45 168 Z" fill="#1e3a8a" stroke="url(#sxhs-gold)" stroke-width="1.5"/>
  <text x="100" y="163" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="7.5" fill="#ffffff" letter-spacing="1.2">ST. XAVIER'S</text>

  <!-- Laurel Wreath Leaves Around Bottom -->
  <g fill="url(#sxhs-gold)">
    <path d="M 52 110 Q 42 125 50 142 Q 46 128 52 110 Z" />
    <path d="M 40 118 Q 30 130 40 145 Q 35 132 40 118 Z" />
    <path d="M 148 110 Q 158 125 150 142 Q 154 128 148 110 Z" />
    <path d="M 160 118 Q 170 130 160 145 Q 165 132 160 118 Z" />
  </g>

  <!-- Top Text -->
  <text x="100" y="38" text-anchor="middle" font-family="sans-serif" font-weight="800" font-size="9" fill="#1e3a8a" letter-spacing="2">ESTD 1958</text>
  <text x="100" y="26" text-anchor="middle" font-family="sans-serif" font-weight="900" font-size="10.5" fill="#0f172a" letter-spacing="1.5">LUCET ET ARDET</text>
</svg>
